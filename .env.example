# Copy to .env. Never commit .env or real credentials.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DATABASE_URL=postgresql://clinic:replace-db-password@127.0.0.1:5432/clinic
TIME_ZONE=Asia/Kolkata
TRUST_PROXY=False

# Local email prints to the terminal; use an SMTP provider for real delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Clinic <clinic@example.com>

# Durable photo storage. Required for uploads in production.
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
# Optional for S3-compatible providers; leave empty for AWS S3.
AWS_S3_ENDPOINT_URL=
